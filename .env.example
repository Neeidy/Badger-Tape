# Badger Tape — environment template
# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Required — fal.ai API key (image / video / music generation)
FAL_KEY=your_fal_api_key_here

# Optional — explicit ffmpeg / ffprobe paths.
# Leave blank to auto-discover them on your system PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Note: YouTube authentication does NOT use this file.
# It uses client_secrets.json (downloaded from Google Cloud Console) and
# generates token.json on first run. See README.md → Setup.
